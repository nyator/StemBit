# Copy to .env and fill in. Never commit .env.
# Appwrite dev key (Appwrite console -> Project -> Settings -> Dev keys).
# Only needed in development; leave empty for production builds.
EXPO_PUBLIC_APPWRITE_DEV_KEY=

# Public base URL of the Cloudflare R2 bucket holding the loop store -- a custom
# domain, or the bucket's r2.dev URL. No trailing slash. The app reads
# <url>/catalog.json and resolves every object path in it against this.
# Not a secret: it is the public read endpoint, and EXPO_PUBLIC_ vars are
# compiled into the app bundle. R2 API tokens must never go in here.
# See docs/loop-store.md for the bucket layout and the manifest's shape.
EXPO_PUBLIC_LOOP_STORE_URL=
