{
  "expo": {
    "name": "StemBit",
    "slug": "StemBit",
    "scheme": "stembit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "stembit",
      "runtimeVersion": "1.0.0"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#101116"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "runtimeVersion": "1.0.0",
      "package": "com.stembit"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      "expo-font",
      "expo-asset",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#101116"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9c8300a2-cec7-491a-b47b-54c561333c1b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/9c8300a2-cec7-491a-b47b-54c561333c1b"
    },
    "owner": "hhen5562"
  }
}
